<mujoco model="Robot_arm">
    <compiler angle="degree"/>
    <option gravity="0 0 0"/>
    <default>
        <joint damping="0.5"/>
        <geom contype="0" conaffinity="0"/>
    </default>

    <worldbody>
        <light diffuse=".6 .6 .6" pos="0 0 5" dir="0 0 -1"/>
        <geom type="plane" size="5 5 0.1" rgba="0 0 0 1"/>

        <body name="plate" pos="0 0 0.05">
            <geom type="box" size="0.5 0.5 0.05" rgba="0.25 0.25 0.25 1"/>

            <body name="main_body" pos="0 0 0.5">
                <geom type="box" size="0.125 0.125 0.75" rgba="1 1 1 1"/>

                <body name="collarbone" pos="0 0 0.75">
                    <joint name="rotasi_z" type="hinge" axis="0 0 1"/>
                    <geom type="sphere" size="0.2" rgba="0.5 0.5 0.5 1"/>

                    <body name="shoulder" euler="90 0 0">
                        <joint name="rotasi_x" type="hinge" axis="0 0 1" range="0 180"/>
                        <geom type="box" pos="0.2 0 0" size="0.1 0.1 0.1" rgba="0.5 0.5 0.5 1"/>
                        <geom type="box" pos="0.55 0 0" size="0.35 0.05 0.1" rgba="1 1 1 1"/>

                        <body name="elbow" pos="0.9 0 0">
                            <joint name="elbow" type="hinge" axis="0 0 1" range="0 180"/>
                            <geom type="cylinder" size="0.1 0.125" rgba="0.5 0.5 0.5 1"/>
                            <geom type="box" pos="0 -0.55 0" size="0.055 0.55 0.1" rgba="1 1 1 1"/>

                            <body name="wrist" euler="-90 0 0">
                                <joint name="wrist" type="hinge" axis="0 0 1" range="-90 90"/>
                                <geom type="cylinder" pos="0 0 -1.1" size="0.125 0.1" rgba="0.5 0.5 0.5 1"/>

                                <body name="palm" pos="0 0 -1.1" euler="90 0 0">
                                    <joint name="palm" type="hinge" axis="0 0 1" range="-180 0"/>

                                    <body name="palm_tool" euler="0 0 -90">
                                        <geom type="cylinder" size="0.075 0.15" rgba="1 1 1 1"/>

                                        <body name="finger_11" pos="0 0.2 0.2" euler="0 90 0">
                                            <joint name="F1" type="hinge" axis="0 0 1" range="0 30" pos="0.1 -0.15 0"/>
                                            <geom type="box" size="0.025 0.15 0.05" rgba="1 1 1 1" euler="0 0 30"/>

                                            <body name="finger_12" pos="0 0.255 0">
                                                <geom type="box" size="0.025 0.15 0.05" rgba="1 1 1 1" euler="0 0 -30"/>

                                            </body>
                                        </body>

                                        <body name="finger_21" pos="0 0.2 -0.2" euler="0 90 0">
                                            <joint name="F2" type="hinge" axis="0 0 1" range="-30 0" pos="-0.1 -0.15 0"/>
                                            <geom type="box" size="0.025 0.15 0.05" rgba="1 1 1 1" euler="0 0 -30"/>

                                            <body name="finger_22" pos="0 0.255 0">
                                                <geom type="box" size="0.025 0.15 0.05" rgba="1 1 1 1" euler="0 0 30"/>

                                            </body>

                                        </body>
                                    </body>
                                </body>
                            </body>
                        </body>
                    </body>
                </body>
            </body>
        </body>
    </worldbody>

    <actuator>
        <position name="p_rotasiZ" joint="rotasi_z" kp="10500" kv="2600" ctrlrange="-180 180"/>
        <position name="p_rotasiX" joint="rotasi_x" kp="10500" kv="2600" ctrlrange="0 180"/>
        <position name="p_elbow" joint="elbow" kp="5500" kv="1100" ctrlrange="0 180"/>
        <position name="p_wrist" joint="wrist" kp="340" kv="46" ctrlrange="-90 90"/>
        <position name="p_palm" joint="palm" kp="170" kv="22" ctrlrange="-180 0"/>
        <position name="p_F1" joint="F1" kp="75" kv="10" ctrlrange="-30 0"/>
        <position name="p_F2" joint="F2" kp="75" kv="10" ctrlrange="0 30"/>
    </actuator>

    <sensor>
        <jointpos name="pos_rotasiZ" joint="rotasi_z"/>
        <jointpos name="pos_rotasiX" joint="rotasi_x"/>
        <jointpos name="pos_elbow" joint="elbow"/>
        <jointpos name="pos_wrist" joint="wrist"/>
        <jointpos name="pos_palm" joint="palm"/>
        <jointpos name="pos_F1" joint="F1"/>
        <jointpos name="pos_F2" joint="F2"/>
    </sensor>
</mujoco>