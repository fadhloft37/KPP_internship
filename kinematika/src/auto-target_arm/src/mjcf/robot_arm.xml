<mujoco model="Robot_arm">
    <compiler angle="radian"/>
    <option gravity="0 0 0"/>
    <default>
        <joint damping="0.5"/>
        <geom contype="0" conaffinity="0"/>
    </default>

    <worldbody>
        <light diffuse=".6 .6 .6" pos="0 0 5" dir="0 0 -1"/>
        <geom type="plane" size="5 5 0.1" rgba="0 0 0 1"/>

        <body name="plate" pos="0 0 0.05">
            <geom type="box" size="0.5 0.5 0.05" rgba="0.25 0.25 0.25 1"/>

            <body name="main_body" pos="0 0 0.5">
                <geom type="box" size="0.125 0.125 0.75" rgba="1 1 1 1"/>

                <body name="collarbone" pos="0 0 0.75">
                    <joint name="rotasi_z" type="hinge" axis="0 0 1"/>
                    <geom type="sphere" size="0.2" rgba="0.5 0.5 0.5 1"/>
                  
                    <body name="shoulder" pos="0 0.2 0">
                        <joint name="rotasi_x" type="hinge" axis="1 0 0" range="0 3.14" pos="0 -0.2 0"/>
                        <geom type="box" size="0.1 0.1 0.1" rgba="0.5 0.5 0.5 1"/>

                        <body name="upper_arm" pos="0 0.35 0">
                            <geom type="box" size="0.1 0.05 0.35" rgba="1 1 1 1" euler="1.5708 0 0"/>

                            <body name="elbow" pos="0 0.35 0">
                                <joint name="elbow" type="hinge" axis="1 0 0" range="0 3.14" pos="0 0 0"/>
                                <geom type="cylinder" size="0.1 0.125" rgba="0.5 0.5 0.5 1" euler="0 1.5708 0"/>

                                <body name="forearm" pos="0 0 -0.55">
                                    <geom type="box" size="0.1 0.05 0.55" rgba="1 1 1 1"/>

                                    <body name="wrist" pos="0 0 -0.5">
                                        <joint name="wrist" type="hinge" axis="0 0 1" range="-1.57 1.57" pos="0 0 0"/>
                                        <geom type="cylinder" size="0.125 0.1" rgba="0.5 0.5 0.5 1" euler="0 1.5708 0"/>
                            
                                        <body name="palm" pos="0 0 0">
                                            <joint name="palm" type="hinge" axis="1 0 0" range="-3.14 0" pos="0 0 0"/>
                                            <geom type="cylinder" size="0.075 0.15" rgba="1 1 1 1" euler="0 1.5708 0"/>

                                            <body name="finger_11" pos="0.2 0.2 0" euler="1.5708 0 0">
                                                <joint name="F1" type="hinge" axis="0 1 0" range="-0.5 0" pos="-0.15 0 0.15"/>
                                                <geom type="box" size="0.025 0.05 0.15" rgba="1 1 1 1" euler="0 -0.5236 0"/>

                                                <body name="finger_12" pos="0 0 -0.225">
                                                    <geom type="box" size="0.025 0.05 0.15" rgba="1 1 1 1" euler="0 0.5236 0"/>

                                                </body>
                                            </body>
                                
                                            <body name="finger_21" pos="-0.2 0.2 0" euler="1.5708 0 0">
                                                <joint name="F2" type="hinge" axis="0 1 0" range="0 0.5" pos="0.15 0 0.15"/>
                                                <geom type="box" size="0.025 0.05 0.15" rgba="1 1 1 1" euler="0 0.5236 0"/>

                                                <body name="finger_22" pos="0 0 -0.225">
                                                    <geom type="box" size="0.025 0.05 0.15" rgba="1 1 1 1" euler="0 -0.5236 0"/>

                                                </body>

                                            </body>
                                        </body>
                                    </body>
                                </body>
                            </body>
                        </body>
                    </body> 
                </body>
            </body>
        </body>
    </worldbody>

    <actuator>
        <position name="p_rotasiZ" joint="rotasi_z" kp="10500" kv="2600" ctrlrange="-3.14 3.14"/>
        <position name="p_rotasiX" joint="rotasi_x" kp="10500" kv="2600" ctrlrange="0 3.14"/>
        <position name="p_elbow" joint="elbow" kp="5500" kv="1100" ctrlrange="0 3.14"/>
        <position name="p_wrist" joint="wrist" kp="340" kv="46" ctrlrange="-1.57 1.57"/>
        <position name="p_palm" joint="palm" kp="170" kv="22" ctrlrange="-3.14 0"/>
        <position name="p_F1" joint="F1" kp="75" kv="10" ctrlrange="-0.5 0"/>
        <position name="p_F2" joint="F2" kp="75" kv="10" ctrlrange="0 0.5"/>
    </actuator>

    <sensor>
        <jointpos name="pos_rotasiZ" joint="rotasi_z"/>
        <jointpos name="pos_rotasiX" joint="rotasi_x"/>
        <jointpos name="pos_elbow" joint="elbow"/>
        <jointpos name="pos_wrist" joint="wrist"/>
        <jointpos name="pos_palm" joint="palm"/>
        <jointpos name="pos_F1" joint="F1"/>
        <jointpos name="pos_F2" joint="F2"/>
    </sensor>
</mujoco>